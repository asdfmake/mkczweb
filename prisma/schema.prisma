datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model NewsArticle {
  id        Int         @id @default(autoincrement())
  header    String
  text      String
  date      String
  featured  Boolean     @default(false)
  // Multilingual titles
  header_sr String?
  header_en String?
  header_ru String?
  // Multilingual content
  text_sr   String?
  text_en   String?
  text_ru   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  images    NewsImage[]
}

model NewsImage {
  id        Int          @id @default(autoincrement())
  filename  String
  articleId Int
  article   NewsArticle  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}
